{
  "name": "@lingua/core",
  "version": "0.0.0",
  "private": true,
  "description": "Domain logic: content loading and validation, grading, scheduling, quota rules. Pure and unit-testable: no web framework, no database client.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@lingua/types": "workspace:*",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
