{
  "name": "@lingua/config",
  "version": "0.0.0",
  "private": true,
  "description": "Runtime environment validation. Shared tooling configs (eslint, tsconfig) live at the repository root so flat config resolves from every package.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "eslint": "10.11.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
