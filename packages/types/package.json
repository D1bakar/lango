  },
  "devDependencies": {
    "@types/node": "26.6.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
