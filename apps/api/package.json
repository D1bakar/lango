{
  "name": "@lingua/api",
  "version": "0.0.0",
  "private": true,
  "description": "HTTP API. Owns authentication, authorization, grading, progress, and quota enforcement.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/jwt": "9.0.2",
    "@lingua/config": "workspace:*",
    "@lingua/core": "workspace:*",
    "@lingua/db": "workspace:*",
    "@lingua/types": "workspace:*",
    "argon2": "0.41.1",
    "fastify": "5.12.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
