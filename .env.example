# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Never commit `.env` — it is gitignored.
#
# Every variable below has a development default or is optional at this stage,
# so the API starts without any infrastructure. `DATABASE_URL`, `REDIS_URL`, and
# `AUTH_SECRET` become REQUIRED in Phase 3.
#
# The authoritative schema is packages/config/src/env.ts. This file must stay in
# sync with it. Values here are placeholders, never real credentials.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------

# development | test | production
NODE_ENV=development

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

API_HOST=0.0.0.0
API_PORT=3001

# Comma-separated browser origins allowed to call the API. Credentials are sent,
# so a wildcard is not acceptable here.
CORS_ORIGINS=http://localhost:3000

# --- Data stores (required from Phase 3) -----------------------------------

# PostgreSQL. Use a local container or a managed instance with branching.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lingua

# Redis. Rate limits, voice quota counters, and cached session state.
REDIS_URL=redis://localhost:6379

# Signs session tokens. Minimum 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating this invalidates every active session.
AUTH_SECRET=replace-me-with-at-least-32-random-characters

# --- Object storage (required from Phase 5, voice turns) -------------------
# S3-compatible. Voice audio is uploaded directly from the client with a
# presigned URL, never proxied through the API process.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- AI providers (required from Phase 5) ----------------------------------
# Keys are read server-side only. A key that reaches the browser is a leak.
LLM_API_KEY=
STT_API_KEY=
TTS_API_KEY=

# --- Web client ------------------------------------------------------------
# Server-side only: the browser never talks to the API directly, so this is not
# a NEXT_PUBLIC_ variable and the API's address is not exposed to clients.
API_BASE_URL=http://localhost:3001

# --- Observability (all optional) ------------------------------------------
# Absence of any of these must never break a request.
SENTRY_DSN=
POSTHOG_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
